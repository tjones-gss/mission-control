# Copy to docker/.env and edit. Compose cannot expand `~` on Windows, so use
# explicit absolute paths. Forward slashes work fine on Windows here.

# Your Claude Code state + auth directory (contains projects/, .credentials.json).
CLAUDE_DIR=C:/Users/Travis/.claude

# Where agents' built apps should land on your host.
WORKSPACE_DIR=C:/Users/Travis/Desktop/Projects/mc-workspace
