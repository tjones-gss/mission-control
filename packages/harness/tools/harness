def cmd_status(args, root: Path) -> int:
    project = load_yaml(root / ".harness/project-state.yml")
    pipeline = load_yaml(root / ".harness/pipeline-state.yml")
    missions = load_yaml(root / ".harness/mission-index.yml")
    readiness = load_yaml(root / ".harness/readiness-score.yml")
    plans = load_yaml(root / ".harness/plan-index.yml")

    if args.json:
        out = {
            "project": project.get("project", {}),
            "stack": project.get("stack", {}),
            "pipeline": pipeline.get("pipeline", {}),
            "missions": missions.get("missions", {}),
            "plans": plans.get("plans", {}),
            "readiness_overall": get(readiness, "readiness", "overall", default={}),
            "next": project.get("next", {}),
        }
        print(json.dumps(out, indent=2, default=str))
        return 0

    name = get(project, "project", "name", default="(unset)")
    mode = get(project, "project", "mode", default="(unset)")
    stage = get(project, "project", "stage", default="(unset)")

    print(colorize(f"{emoji_or_ascii('📁', '[project]')} {name}", "bold"))
    print(f"   Mode:    {colorize(str(mode), 'cyan')}")
    print(f"   Stage:   {stage}")

    pl_active = get(pipeline, "pipeline", "active", default="(unset)")
    pl_phase = get(pipeline, "pipeline", "phase", default="(unset)")
    pl_gate = get(pipeline, "pipeline", "gate", default="(unset)")

    print()
    print(colorize(f"{emoji_or_ascii('🚦', '[pipeline]')} {pl_active}", "bold"))
    print(f"   Phase:  {pl_phase}")
    print(f"   Gate:   {pl_gate}")

    current_mission = get(project, "current", "mission")
    if current_mission:
        print()
        print(colorize(f"{emoji_or_ascii('🎯', '[mission]')} {current_mission}", "bold"))

    # Mission summary
    mission_dict = missions.get("missions") or {}
    if isinstance(mission_dict, dict) and mission_dict:
        counts = {}
        for m, data in mission_dict.items():
            if not isinstance(data, dict):
                continue
            s = data.get("status", "unknown")
            counts[s] = counts.get(s, 0) + 1
        print()
        print(colorize(f"{emoji_or_ascii('📋', '[missions]')} {sum(counts.values())} total", "bold"))
        for status, n in sorted(counts.items()):
            print(f"   {status}: {n}")

    # Readiness
    overall = get(readiness, "readiness", "overall", default={})
    if overall:
        score = overall.get("score", 0)
        mvp_ready = overall.get("mvp_ready", False)
        color = "green" if mvp_ready else "yellow"
        ready_mark = emoji_or_ascii("✓", "yes") if mvp_ready else emoji_or_ascii("✗", "no")
        print()
        print(colorize(f"{emoji_or_ascii('📊', '[readiness]')} {score}/100  (MVP ready: {ready_mark})", color))

        # Blockers per area
        blockers = []
        for area, data in (readiness.get("readiness") or {}).items():
            if area == "overall" or not isinstance(data, dict):
                continue
            for b in data.get("blockers", []) or []:
                blockers.append((area, b))
        if blockers:
            print()
            print(colorize(f"{emoji_or_ascii('⚠️', '[blockers]')}", "yellow"))
            for area, b in blockers:
                print(f"   • [{area}] {b}")

    # Next action
    nxt = project.get("next") or {}
    if nxt:
        print()
        agent = nxt.get("recommended_agent", "?")
        action = nxt.get("recommended_action", "?")
        print(colorize(f"{emoji_or_ascii('➡️', '->')}  next: {colorize(agent, 'cyan')} → {action}", "bold"))
        if nxt.get("blocked"):
            print(colorize(f"   BLOCKED: {nxt.get('blocker', '(unknown)')}", "red"))

    return 0


def cmd_check(args, root: Path) -> int:
    """Verify harness install. Three layers: control plane, adapter, functional."""
    failures = []
    warnings = []

    def ok(msg):
        print(f"  {colorize(emoji_or_ascii('✓', '[ok]'), 'green')} {msg}")

    def fail(msg):
        print(f"  {colorize(emoji_or_ascii('✗', '[FAIL]'), 'red')} {msg}")
        failures.append(msg)

    def warn(msg):
        print(f"  {colorize(emoji_or_ascii('⚠', '[warn]'), 'yellow')} {msg}")
        warnings.append(msg)

    # --- Layer 1: control plane ---
    print(colorize("Control plane", "bold"))
    required = [
        ".harness/project-state.yml",
        ".harness/pipeline-state.yml",
        ".harness/mission-index.yml",
        ".harness/context-manifest.yml",
        ".harness/quality-gates.yml",
        ".harness/danger-zone.yml",
        ".harness/human-approval-policy.yml",
        ".harness/anti-patterns.yml",
        ".harness/artifact-index.yml",
        ".harness/mvp-checklist.yml",
        ".harness/readiness-score.yml",
        "AGENTS.md",
    ]
    for rel in required:
        p = root / rel
        if not p.exists():
            fail(f"missing: {rel}")
            continue
        if rel.endswith(".yml"):
            try:
                yaml.safe_load(p.read_text())
                ok(f"{rel} parses")
            except yaml.YAMLError as e:
                fail(f"{rel} invalid YAML: {e}")
        else:
            ok(f"{rel} present")

    # mode set?
    project = load_yaml(root / ".harness/project-state.yml")
    mode = get(project, "project", "mode")
    if mode in (None, "unset", ""):
        warn("project.mode is 'unset' — run `harness init <mode>`")
    else:
        ok(f"project.mode = {mode}")

    # active pipeline exists?
    pipeline_state = load_yaml(root / ".harness/pipeline-state.yml")
    active = get(pipeline_state, "pipeline", "active")
    if active and active != "unset":
        pp = root / "pipelines" / f"{active}.yml"
        if pp.exists():
            ok(f"active pipeline file present: pipelines/{active}.yml")
        else:
            fail(f"active pipeline references missing file: pipelines/{active}.yml")

    # --- Layer 2: Claude Code adapter ---
    print()
    print(colorize("Claude Code adapter", "bold"))
    settings_path = root / ".claude/settings.json"
    if not settings_path.exists():
        warn("no .claude/settings.json — adapter not installed (skip if not using Claude Code)")
    else:
        try:
            settings = json.loads(settings_path.read_text())
            ok(".claude/settings.json parses")

            # walk every hook entry, verify scripts exist + executable
            hooks_section = settings.get("hooks", {})
            for event, groups in hooks_section.items():
                for group in groups:
                    for h in group.get("hooks", []):
                        if h.get("type") != "command":
                            continue
                        cmd = h.get("command", "")
                        rp = resolve_claude_hook_script(cmd, root)
                        if not rp.exists():
                            fail(f"hook script missing for {event}: {rp}")
                            continue
                        if not os.access(rp, os.X_OK):
                            warn(f"hook script not executable: {rp.relative_to(root)} — run chmod +x")
                        else:
                            ok(f"{event} hook: {rp.name}")
        except json.JSONDecodeError as e:
            fail(f".claude/settings.json invalid JSON: {e}")

    # CLAUDE.md
    if (root / "CLAUDE.md").exists():
        ok("CLAUDE.md present")
    else:
        warn("CLAUDE.md missing — Claude Code won't auto-load harness context")

    # Subagents
    agents_dir = root / ".claude/agents"
    if agents_dir.is_dir():
        agents = list(agents_dir.glob("*.md"))
        if not agents:
            warn(".claude/agents/ is empty")
        for a in agents:
            content = a.read_text()
            m = re.match(r"^---\n(.*?)\n---", content, re.DOTALL)
            if not m:
                fail(f"subagent missing YAML frontmatter: {a.name}")
                continue
            fm = m.group(1)
            if "name:" not in fm or "description:" not in fm:
                fail(f"subagent frontmatter incomplete: {a.name}")
            else:
                ok(f"subagent: {a.name}")

    # --- Layer 2b: Cursor adapter ---
    print()
    print(colorize("Cursor adapter", "bold"))
    cursor_hooks_json = root / ".cursor/hooks.json"
    cursor_adapter_hooks = root / "adapters/cursor/.cursor/hooks.json"
    if not cursor_hooks_json.exists() and not cursor_adapter_hooks.exists():
        warn("no .cursor/hooks.json — Cursor adapter not installed (copy adapters/cursor/.cursor/)")
    else:
        hooks_json_path = cursor_hooks_json if cursor_hooks_json.exists() else cursor_adapter_hooks
        try:
            cursor_cfg = json.loads(hooks_json_path.read_text())
            ok(f"{hooks_json_path.relative_to(root)} parses")
            adapter_hooks_dir = root / "adapters/cursor/.cursor/hooks"
            installed_hooks_dir = root / ".cursor/hooks"
            hooks_dir_for_scripts = (
                installed_hooks_dir
                if installed_hooks_dir.is_dir()
                else adapter_hooks_dir
            )
            cursor_hooks = cursor_cfg.get("hooks", {})
            for event, entries in cursor_hooks.items():
                if not isinstance(entries, list):
                    continue
                for entry in entries:
                    if not isinstance(entry, dict):
                        continue
                    cmd = entry.get("command", "")
                    if not cmd:
                        continue
                    parts = cmd.strip().split()
                    script_name = Path(parts[-1]).name if parts else Path(cmd).name
                    rp = hooks_dir_for_scripts / script_name
                    if not rp.exists():
                        rp = root / cmd if not Path(cmd).is_absolute() else Path(cmd)
                    if not rp.exists():
                        fail(f"Cursor hook script missing for {event}: {cmd}")
                        continue
                    if os.name != "nt" and not os.access(rp, os.X_OK):
                        warn(f"Cursor hook not executable: {rp.relative_to(root)} — run chmod +x")
                    else:
                        ok(f"Cursor {event} hook: {rp.name}")
        except json.JSONDecodeError as e:
            fail(f"{hooks_json_path} invalid JSON: {e}")

    cursor_rules = root / ".cursor/rules"
    if cursor_rules.is_dir() and list(cursor_rules.glob("*.mdc")):
        ok(f".cursor/rules/ ({len(list(cursor_rules.glob('*.mdc')))} rules)")
    elif (root / "adapters/cursor/.cursor/rules").is_dir():
        ok("adapters/cursor/.cursor/rules/ present (copy to project root to install)")

    # jq available?
    jq_path = shutil_which("jq")
    if jq_path:
        ok(f"jq available at {jq_path}")
    else:
        warn("jq not installed — hooks degrade to pass-through (no enforcement)")

    # --- Layer 3: functional smoke tests ---
    print()
    print(colorize("Functional smoke tests", "bold"))
    hooks_dir = root / ".claude/hooks"
    if hooks_dir.is_dir() and jq_path:
        # 1. block-danger denies rm -rf
        block_danger = hooks_dir / "block-danger.sh"
        if block_danger.exists():
            out = run_with_stdin(block_danger, '{"tool_input":{"command":"rm -rf /tmp/test"}}', root)
            if '"permissionDecision": "deny"' in out:
                ok("block-danger.sh denies dangerous command")
            else:
                fail("block-danger.sh did NOT deny `rm -rf` — got: " + (out[:120] or "(empty)"))

            out = run_with_stdin(block_danger, '{"tool_input":{"command":"ls -la"}}', root)
            if out.strip() == "":
                ok("block-danger.sh allows safe command")
            else:
                fail(f"block-danger.sh produced unexpected output for safe command: {out[:120]}")

        require_mission = hooks_dir / "require-mission.sh"
        if require_mission.exists():
            test_path = str(root / ".harness/project-state.yml")
            out = run_with_stdin(require_mission, json.dumps({"tool_input": {"file_path": test_path}}), root)
            if out.strip() == "":
                ok("require-mission.sh allows edits to .harness/")
            else:
                fail(f"require-mission.sh should allow .harness/ edits, got: {out[:120]}")

    elif hooks_dir.is_dir() and not jq_path:
        warn("skipping Claude functional smoke tests — jq not installed")

    # Cursor hook smoke tests (adapter source or installed copy)
    cursor_hooks_dir = root / ".cursor/hooks"
    if not cursor_hooks_dir.is_dir():
        cursor_hooks_dir = root / "adapters/cursor/.cursor/hooks"
    bash_available = bool(shutil_which("bash"))
    if cursor_hooks_dir.is_dir() and jq_path:
        c_block = cursor_hooks_dir / "block-danger.sh"
        if c_block.exists():
            out = run_with_stdin(c_block, '{"command":"rm -rf /tmp/test"}', root, cursor=True)
            if '"permission": "deny"' in out:
                ok("Cursor block-danger.sh denies dangerous command")
            elif not bash_available:
                warn("Cursor block-danger.sh smoke test skipped — bash not in PATH (install Git Bash on Windows)")
            else:
                fail("Cursor block-danger.sh did NOT deny rm -rf — got: " + (out[:120] or "(empty)"))

            out = run_with_stdin(c_block, '{"command":"ls -la"}', root, cursor=True)
            if '"permission": "allow"' in out:
                ok("Cursor block-danger.sh allows safe command")
            elif not bash_available:
                warn("Cursor block-danger.sh safe-command smoke test skipped — bash not in PATH")
            elif out.strip() == "" or "(error:" in out:
                fail(f"Cursor block-danger.sh unexpected safe output: {out[:120]}")

        c_require = cursor_hooks_dir / "require-mission.sh"
        if c_require.exists():
            test_path = str(root / ".harness/project-state.yml")
            out = run_with_stdin(
                c_require, json.dumps({"tool_input": {"file_path": test_path}}), root, cursor=True
            )
            if '"permission": "allow"' in out:
                ok("Cursor require-mission.sh allows .harness/ edits (bootstrap/no mission)")
            elif not bash_available:
                warn("Cursor require-mission.sh smoke test skipped — bash not in PATH (install Git Bash on Windows)")
            else:
                fail(f"Cursor require-mission.sh unexpected: {out[:120]}")
    elif cursor_hooks_dir.is_dir() and not jq_path:
        warn("skipping Cursor functional smoke tests — jq not installed")

    # --- Layer 4: pipelines ---
    print()
    print(colorize("Pipelines", "bold"))
    pipelines_dir = root / "pipelines"
    referenced_agents = set()
    referenced_phase_models = set()
    if not pipelines_dir.is_dir():
        warn("no pipelines/ directory")
    else:
        for pp in sorted(pipelines_dir.glob("*.yml")):
            try:
                d = yaml.safe_load(pp.read_text())
            except yaml.YAMLError as e:
                fail(f"{pp.name}: invalid YAML: {e}")
                continue
            if "pipeline" not in d or "phases" not in d:
                fail(f"{pp.name}: missing top-level `pipeline` or `phases`")
                continue
            phase_problems = []
            for i, ph in enumerate(d.get("phases") or []):
                if not isinstance(ph, dict):
                    phase_problems.append(f"phase {i}: not an object (bare string?)")
                    continue
                pid = ph.get("id", f"#{i}")
                # Required: id, agent
                for required_key in ("id", "agent"):
                    if required_key not in ph:
                        phase_problems.append(f"phase {pid}: missing `{required_key}`")
                if "agent" in ph and ph["agent"]:
                    referenced_agents.add(ph["agent"])
                if ph.get("model"):
                    referenced_phase_models.add(ph["model"])
                # Outputs OR explicit no_outputs_reason
                if "outputs" not in ph and "no_outputs_reason" not in ph:
                    phase_problems.append(
                        f"phase {pid}: missing `outputs` (or declare `no_outputs_reason: <why>`)"
                    )
                # Gate.required OR explicit no_gate_reason
                if "gate" not in ph and "no_gate_reason" not in ph:
                    phase_problems.append(
                        f"phase {pid}: missing `gate` (or declare `no_gate_reason: <why>`)"
                    )
                if "gate" in ph:
                    gate = ph.get("gate") or {}
                    if "required" not in gate and "no_gate_reason" not in ph:
                        phase_problems.append(
                            f"phase {pid}: gate has no `required` list"
                        )
                # Shared contract validation (single definition in
                # harness_core.pipelines.validate_phase — same check the
                # orchestrator loader runs). Catches typos in known fields, bad
                # enums, and wrong types the semantic checks above don't. No-op
                # when the contracts schema is unavailable (standalone install).
                for schema_err in validate_phase(ph):
                    phase_problems.append(f"phase {pid}: {schema_err}")
            if phase_problems:
                fail(f"{pp.name}: {len(phase_problems)} issue(s)")
                for pb in phase_problems:
                    print(f"      - {pb}")
            else:
                ok(f"{pp.name}: {len(d.get('phases', []))} phases, schema valid")

    # --- Layer 5: agent reference resolution ---
    print()
    print(colorize("Agent references", "bold"))
    registry_path = root / ".harness/agent-registry.yml"
    aliases = {}
    if registry_path.exists():
        registry = load_yaml(registry_path)
        aliases = (registry.get("aliases") or {}) if isinstance(registry, dict) else {}
        ok(f".harness/agent-registry.yml present ({len(aliases)} alias(es))")
    else:
        warn(".harness/agent-registry.yml missing — using default resolution rules only")

    role_dir = root / "agents/roles"
    adapter_dir = root / "adapters/claude-code/.claude/agents"
    for agent in sorted(referenced_agents):
        # 1) alias hit
        if agent in aliases:
            target = aliases[agent]
            if (root / target).exists():
                ok(f"agent `{agent}` -> alias -> {target}")
            else:
                fail(f"agent `{agent}` aliased to {target} but file missing")
            continue
        # 2) agents/roles/<name>.md
        role_file = role_dir / f"{agent}.md"
        # 3) claude-code subagent
        adapter_file = adapter_dir / f"{agent}.md"
        if role_file.exists():
            ok(f"agent `{agent}` -> agents/roles/{agent}.md")
        elif adapter_file.exists():
            ok(f"agent `{agent}` -> adapters/claude-code/.claude/agents/{agent}.md")
        else:
            warn(
                f"agent `{agent}` unresolved — no agents/roles/{agent}.md, "
                f"no claude-code subagent, no alias in agent-registry.yml"
            )

    # --- Layer 5b: model-tier routing (optional feature) ---
    print()
    print(colorize("Model tiers", "bold"))
    tiers_path = root / ".harness/model-tiers.yml"
    if not tiers_path.exists():
        ok("no .harness/model-tiers.yml — single-model behavior (model-tier routing is optional)")
    else:
        mt = load_yaml(tiers_path)
        tiers = mt.get("tiers")
        if not isinstance(tiers, dict) or not tiers:
            warn(".harness/model-tiers.yml has no `tiers:` map — feature inert")
            tiers = {}
        else:
            ok(f"model-tiers.yml defines {len(tiers)} tier(s): {', '.join(sorted(tiers))}")
        default_tier = mt.get("default_tier")
        if default_tier not in (None, "", "null") and default_tier not in tiers:
            fail(f"model-tiers.yml `default_tier: {default_tier}` is not a defined tier")
        # role_tiers values are aliases by convention — flag undefined ones (typos)
        role_tiers = (load_yaml(registry_path).get("role_tiers") or {}) if registry_path.exists() else {}
        if isinstance(role_tiers, dict):
            for role, tier in role_tiers.items():
                if tier not in tiers:
                    warn(f"agent-registry.yml role_tiers[{role}] = `{tier}` is not a defined tier alias")
        # phase `model:` values may be aliases OR literal model strings — list them
        if referenced_phase_models:
            for m in sorted(referenced_phase_models):
                kind = "tier alias" if m in tiers else "literal model string"
                ok(f"pipeline phase model `{m}` ({kind})")

    # --- Layer 6: mission index + current mission ---
    print()
    print(colorize("Missions", "bold"))
    current_mission = get(project, "current", "mission")
    if current_mission and current_mission not in (None, "null", "unset"):
        mi = load_yaml(root / ".harness/mission-index.yml")
        entry = (mi.get("missions") or {}).get(current_mission)
        if not entry:
            fail(
                f"current.mission = `{current_mission}` but no matching entry in "
                f".harness/mission-index.yml"
            )
        else:
            mission_file_rel = entry.get("file")
            if not mission_file_rel:
                fail(
                    f"mission `{current_mission}` has no `file:` field in mission-index.yml"
                )
            elif not (root / mission_file_rel).exists():
                fail(
                    f"mission `{current_mission}` file does not exist: {mission_file_rel}"
                )
            else:
                ok(f"current mission `{current_mission}` -> {mission_file_rel}")
    else:
        ok("no current.mission set (orchestrator/bootstrap state)")

    # Every mission-index entry should point to a real file
    mi = load_yaml(root / ".harness/mission-index.yml")
    for mid, data in (mi.get("missions") or {}).items():
        if not isinstance(data, dict):
            continue
        f_rel = data.get("file")
        if not f_rel:
            warn(f"mission `{mid}`: no `file:` field")
            continue
        if not (root / f_rel).exists():
            fail(f"mission `{mid}`: file does not exist: {f_rel}")
        else:
            # v5.1.1: catch-all Allowed patterns (`*` or `**`) defeat mission
            # scope. Warn so authors either tighten the glob or acknowledge it
            # explicitly. Forbidden Files still apply, so this is a warning,
            # not a failure.
            for pat in _allowed_patterns(root / f_rel):
                if pat in ("*", "**"):
                    warn(
                        f"mission `{mid}`: Allowed Files pattern `{pat}` is "
                        f"a catch-all — any path under the project root "
                        f"matches. Tighten the glob or split the mission."
                    )

    # --- Layer 7: danger-zone readable + non-empty ---
    print()
    print(colorize("Danger zone", "bold"))
    dz_path = root / ".harness/danger-zone.yml"
    if not dz_path.exists():
        fail(".harness/danger-zone.yml missing — block-danger.sh will use built-in fallback")
    else:
        dz = load_yaml(dz_path)
        patterns = dz.get("blocked_command_patterns") or []
        if not patterns:
            warn(".harness/danger-zone.yml has no `blocked_command_patterns` list")
        else:
            ok(f"danger-zone has {len(patterns)} blocked pattern(s)")
        if not (dz.get("dangerous_operations") or {}).get("require_human_approval"):
            warn(".harness/danger-zone.yml has no `dangerous_operations.require_human_approval`")

    # --- Verdict ---
    print()
    if failures:
        print(colorize(f"{emoji_or_ascii('✗', '[BROKEN]')} BROKEN — {len(failures)} failure(s), {len(warnings)} warning(s)", "red"))
        return 1
    if warnings and args.strict:
        print(colorize(f"{emoji_or_ascii('⚠', '[DEGRADED]')} DEGRADED (strict) — {len(warnings)} warning(s)", "yellow"))
        return 1
    if warnings:
        print(colorize(f"{emoji_or_ascii('⚠', '[DEGRADED]')} DEGRADED — {len(warnings)} warning(s), 0 failures", "yellow"))
        return 0
    print(colorize(f"{emoji_or_ascii('✓', '[HEALTHY]')} HEALTHY — all checks passed", "green"))
    return 0


def cmd_next(args, root: Path) -> int:
    """Apply the mission selection policy and report the next action."""
    project = load_yaml(root / ".harness/project-state.yml")
    pipeline = load_yaml(root / ".harness/pipeline-state.yml")
    missions = load_yaml(root / ".harness/mission-index.yml")

    mode = get(project, "project", "mode")
    if mode in (None, "unset", ""):
        print("project mode is unset. run: harness init <mode>", file=sys.stderr)
        return 2

    # Apply selection policy
    selection = missions.get("selection_policy", {}) or {}
    do_not_select = set(missions.get("do_not_select", []) or [])

    mission_dict = (missions.get("missions") or {})
    if not isinstance(mission_dict, dict):
        mission_dict = {}

    ready = []
    for mid, data in mission_dict.items():
        if not isinstance(data, dict):
            continue
        status = data.get("status", "")
        if status in ("ready",) and status not in do_not_select:
            ready.append((mid, data))

    if args.json:
        print(json.dumps({
            "mode": mode,
            "phase": get(pipeline, "pipeline", "phase"),
            "ready_missions": [m[0] for m in ready],
            "recommended": ready[0][0] if ready else None,
        }, indent=2))
        return 0

    print(colorize(f"Mode: {mode}", "bold"))
    print(f"Phase: {get(pipeline, 'pipeline', 'phase', default='(unset)')}")

    if not ready:
        print()
        print(colorize("No ready missions in mission-index.yml.", "yellow"))
        print()
        print("Next action depends on phase:")
        recommended_action = get(project, "next", "recommended_action", default="(none)")
        recommended_agent = get(project, "next", "recommended_agent", default="(none)")
        print(f"  agent:  {recommended_agent}")
        print(f"  action: {recommended_action}")
        return 0

    # Sort by priority hint (high > medium > low)
    priority_order = {"high": 0, "medium": 1, "low": 2}
    ready.sort(key=lambda kv: priority_order.get(kv[1].get("priority", "medium"), 1))

    print()
    print(colorize(f"Ready missions ({len(ready)}):", "bold"))
    for mid, data in ready:
        prio = data.get("priority", "medium")
        f = data.get("file", "?")
        print(f"  [{prio:6s}] {mid}  →  {f}")

    print()
    chosen = ready[0]
    print(colorize(f"Recommended: {chosen[0]}", "green"))
    print(f"  spec: {chosen[1].get('spec', '?')}")
    print(f"  adr:  {chosen[1].get('adr', '?')}")
    print(f"  file: {chosen[1].get('file', '?')}")
    return 0


# Modes the harness understands, and the intake stage each one starts in.
VALID_MODES = {"idea-to-mvp", "mvp-sketch", "existing-repo-retrofit", "feature-development",
               "bugfix", "refactor", "release-readiness"}
STAGE_MAP = {
    "idea-to-mvp": "intake",
    "mvp-sketch": "sketch-intake",
    "existing-repo-retrofit": "repo-discovery",
    "feature-development": "classify-feature",
    "bugfix": "reproduce",
    "refactor": "scope",
    "release-readiness": "mvp-checklist",
}

# Where this CLI's bundled templates live (the harness package root). `scaffold`
# copies the reusable config + pipelines from here into a fresh project.
TEMPLATE_ROOT = _REPO_ROOT

# State files that carry per-project runtime data — they must NEVER be copied
# from the harness package's own live state into a new project. `scaffold`
# writes clean baselines for these instead.
_STATEFUL_FILES = {"project-state.yml", "pipeline-state.yml", "mission-index.yml"}


def _compute_init_state(root: Path, mode: str):
    """Compute (project, pipeline_state, summary) for a mode.

    Reads the existing state files under ``root`` and binds the mode's first
    pipeline phase. Raises FileNotFoundError if the pipeline file is missing.
    """
    project = load_yaml(root / ".harness/project-state.yml")
    pipeline_state = load_yaml(root / ".harness/pipeline-state.yml")
    pipeline_file = root / "pipelines" / f"{mode}.yml"
    if not pipeline_file.exists():
        raise FileNotFoundError(pipeline_file)

    pipeline_def = load_yaml(pipeline_file)
    first_phase = (pipeline_def.get("phases") or [{}])[0]
    first_phase_id = first_phase.get("id", "unset")
    first_phase_agent = first_phase.get("agent", "unset")
    first_phase_gate = first_phase.get("gate", {}).get("required", ["unset"])[0]

    project.setdefault("project", {})
    project["project"]["mode"] = mode
    project["project"]["stage"] = STAGE_MAP[mode]
    if project["project"].get("created_at", "unset") == "unset":
        project["project"]["created_at"] = dt.date.today().isoformat()
    if project["project"].get("name", "unset") == "unset":
        project["project"]["name"] = root.name

    project.setdefault("next", {})
    project["next"]["recommended_agent"] = first_phase_agent
    project["next"]["recommended_action"] = f"begin {first_phase_id} phase"
    project["next"]["blocked"] = False

    pipeline_state.setdefault("pipeline", {})
    pipeline_state["pipeline"]["active"] = mode
    pipeline_state["pipeline"]["phase"] = first_phase_id
    pipeline_state["pipeline"]["gate"] = first_phase_gate

    summary = {"mode": mode, "stage": STAGE_MAP[mode], "phase": first_phase_id,
               "gate": first_phase_gate, "agent": first_phase_agent}
    return project, pipeline_state, summary


def _write_init_state(root: Path, project: dict, pipeline_state: dict) -> None:
    (root / ".harness/project-state.yml").write_text(yaml.safe_dump(project, sort_keys=False))
    (root / ".harness/pipeline-state.yml").write_text(yaml.safe_dump(pipeline_state, sort_keys=False))


def cmd_init(args, root: Path) -> int:
    """Bootstrap project-state.yml and pipeline-state.yml for a mode."""
    if args.mode not in VALID_MODES:
        print(f"error: mode must be one of: {', '.join(sorted(VALID_MODES))}", file=sys.stderr)
        return 2

    try:
        project, pipeline_state, summary = _compute_init_state(root, args.mode)
    except FileNotFoundError as e:
        print(f"error: pipeline file missing: {e}", file=sys.stderr)
        return 2

    if args.dry_run:
        print("--- project-state.yml (preview) ---")
        print(yaml.safe_dump(project, sort_keys=False))
        print("--- pipeline-state.yml (preview) ---")
        print(yaml.safe_dump(pipeline_state, sort_keys=False))
        print("(dry-run — nothing written)")
        return 0

    _write_init_state(root, project, pipeline_state)

    print(colorize(f"{emoji_or_ascii('✓', '[ok]')} initialized harness for mode: {args.mode}", "green"))
    print(f"  active pipeline: {args.mode}")
    print(f"  phase:           {summary['phase']}")
    print(f"  next agent:      {summary['agent']}")
    print()
    print("run `harness status` to see the full state, or `harness next` to pick a mission.")

    if not getattr(args, "skip_cursor", False):
        code = _run_cursor_adapter_install(root, hooks_only=True)
        if code != 0:
            print(
                colorize(
                    f"{emoji_or_ascii('⚠', '[warn]')} Cursor hook install exited {code} (init state was written)",
                    "yellow",
                ),
                file=sys.stderr,
            )
    return 0


