    project_path.write_text(yaml.safe_dump(project, sort_keys=False))
    pipeline_path.write_text(yaml.safe_dump(pipeline_state, sort_keys=False))

    print(colorize(f"{emoji_or_ascii('✓', '[ok]')} initialized harness for mode: {args.mode}", "green"))
    print(f"  active pipeline: {args.mode}")
    print(f"  phase:           {first_phase_id}")
    print(f"  next agent:      {first_phase_agent}")
