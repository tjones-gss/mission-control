#!/usr/bin/env python3
"""
harness — Control plane CLI for the Adaptive Agentic Engineering Harness.

Usage:
  harness status                 Show project state, pipeline, mission, blockers, next action
  harness check                  Verify harness is installed and wired correctly
  harness next                   Run mission-selection algorithm, suggest next action (no edits)
  harness init <mode>            Bootstrap project-state.yml + pipeline-state.yml for a mode
                                   modes: idea-to-mvp, mvp-sketch, existing-repo-retrofit,
                                          feature-development, bugfix, refactor, release-readiness
                                   (installs Cursor hooks unless --skip-cursor)
  harness install cursor           Install Cursor adapter hooks + SDK pip packages
  harness install claude           Install Claude Code adapter (.claude/ + CLAUDE.md)
  harness setup                    Wire core harness on this machine (Cursor + Claude hooks)
  harness validate               Run validation commands from active mission, write report
  harness handoff [--mission ID] Generate a session note skeleton from current state
  harness dashboard [--open]     Render runs/dashboard/index.html from harness state files

Options:
  -C <path>     Run as if in <path> instead of the cwd
  --json        Emit machine-readable JSON output (status, check, next)
  --strict      Exit non-zero on warnings (check)
  -h, --help    Show this message
"""

