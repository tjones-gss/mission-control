def _run_cursor_adapter_install(root: Path, *, hooks_only: bool = True) -> int:
    """Run tools/install-cursor-adapter.py for the given harness root."""
    script = root / "tools" / "install-cursor-adapter.py"
    if not script.is_file():
        print(f"warning: Cursor adapter installer missing: {script}", file=sys.stderr)
        return 0
    cmd = [sys.executable, str(script), "--root", str(root)]
    if hooks_only:
        cmd.append("--hooks-only")
    result = subprocess.run(cmd, cwd=str(root))
    return result.returncode


def _run_claude_adapter_install(root: Path) -> int:
    """Run tools/install-claude-adapter.py for the given harness root."""
    script = root / "tools" / "install-claude-adapter.py"
    if not script.is_file():
        print(f"error: Claude adapter installer missing: {script}", file=sys.stderr)
        return 2
    result = subprocess.run([sys.executable, str(script), "--root", str(root)], cwd=str(root))
    return result.returncode



def colorize(text: str, color: str) -> str:
    if not sys.stdout.isatty():
        return text
    codes = {"red": 31, "green": 32, "yellow": 33, "blue": 34, "cyan": 36, "bold": 1, "dim": 2}
    return f"\033[{codes.get(color, 0)}m{text}\033[0m"


def emoji_or_ascii(emoji: str, ascii_: str) -> str:
    """Use ascii fallback if stdout is not a TTY (better in CI logs)."""
    if not sys.stdout.isatty():
        return ascii_
    return emoji


def _allowed_patterns(mission_path: Path) -> list[str]:
    """Return bullet entries under `## Allowed Files` in a mission markdown.

    Delegates to the single shared implementation in harness_core.missions so
    the CLI lint, the scope_adherence gate, and the require-mission.sh hook all
    parse Allowed Files the same way (one definition, no drift).
    """
    return _shared_allowed_patterns(mission_path)


