    print("run `harness status` to see the full state, or `harness next` to pick a mission.")

    if not getattr(args, "skip_cursor", False):
        code = _run_cursor_adapter_install(root, hooks_only=True)
        if code != 0:
            print(
                colorize(
                    f"{emoji_or_ascii('⚠', '[warn]')} Cursor hook install exited {code} (init state was written)",
                    "yellow",
