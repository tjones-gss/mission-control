    pipeline_state.setdefault("pipeline", {})
    pipeline_state["pipeline"]["active"] = args.mode
    pipeline_state["pipeline"]["phase"] = first_phase_id
    pipeline_state["pipeline"]["gate"] = first_phase_gate

    if args.dry_run:
        print("--- project-state.yml (preview) ---")
        print(yaml.safe_dump(project, sort_keys=False))
        print("--- pipeline-state.yml (preview) ---")
        print(yaml.safe_dump(pipeline_state, sort_keys=False))
