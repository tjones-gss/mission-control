def cmd_validate(args, root: Path) -> int:
    """Run validation commands extracted from the active mission file."""
    project = load_yaml(root / ".harness/project-state.yml")
    current_mission_id = get(project, "current", "mission")

    if not current_mission_id:
        # try to find a single ready or in-progress mission
        missions = load_yaml(root / ".harness/mission-index.yml")
        candidates = []
        for mid, data in (missions.get("missions") or {}).items():
            if not isinstance(data, dict):
                continue
            if data.get("status") in ("ready", "in-progress", "review"):
                candidates.append((mid, data))
        if len(candidates) != 1:
            print(f"error: no current mission set in project-state.current.mission, "
                  f"and {len(candidates)} candidates found in mission-index. "
                  f"set current.mission or pass --mission <id>", file=sys.stderr)
            return 2
        current_mission_id, mission_data = candidates[0]
        mission_path = root / mission_data.get("file", "")
    else:
        missions = load_yaml(root / ".harness/mission-index.yml")
        mission_data = (missions.get("missions") or {}).get(current_mission_id, {})
        mission_path = root / mission_data.get("file", "")

    if not mission_path.exists():
        print(f"error: mission file not found: {mission_path}", file=sys.stderr)
        return 2

    # Extract validation commands from the mission file
    mission_text = mission_path.read_text()
    cmds = extract_validation_commands(mission_text)
    if not cmds:
        print(f"error: no validation commands found in {mission_path}", file=sys.stderr)
        print("       expected a `## Validation Commands` section with a fenced bash block.", file=sys.stderr)
        return 2

    # Run each command, capture output, write a report
    report_dir = root / "runs/test-reports"
    report_dir.mkdir(parents=True, exist_ok=True)
    report_path = report_dir / f"{current_mission_id}.md"

    lines = [
        f"# Validation Report: {current_mission_id}",
        f"",
        f"Date: {dt.datetime.now().isoformat(timespec='seconds')}",
        f"Mission: {mission_path}",
        f"",
    ]
    all_ok = True
    for cmd in cmds:
        print(colorize(f"$ {cmd}", "cyan"))
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                                    cwd=str(root), timeout=600)
        except subprocess.TimeoutExpired:
            lines.append(f"## `{cmd}`\n\n**TIMEOUT after 600s**\n")
            print(colorize("  TIMEOUT", "red"))
            all_ok = False
            continue
        status = "✓ pass" if result.returncode == 0 else "✗ fail"
        if result.returncode != 0:
            all_ok = False
        print(colorize(f"  {status} (exit {result.returncode})", "green" if result.returncode == 0 else "red"))
        lines.append(f"## `{cmd}`\n\n**Status:** {status} (exit {result.returncode})\n")
        if result.stdout.strip():
            lines.append("**stdout:**\n```\n" + result.stdout.rstrip() + "\n```\n")
        if result.stderr.strip():
            lines.append("**stderr:**\n```\n" + result.stderr.rstrip() + "\n```\n")
        lines.append("")

    report_path.write_text("\n".join(lines))
    print()
    print(f"report: {report_path.relative_to(root)}")
    return 0 if all_ok else 1


def extract_validation_commands(mission_text: str) -> list[str]:
    """Find the ## Validation Commands section and extract bash-block commands."""
    # Find the section
    m = re.search(r"^##\s+Validation Commands\s*$(.*?)(?=^##\s|\Z)",
                  mission_text, re.MULTILINE | re.DOTALL)
    if not m:
        return []
    section = m.group(1)
    # Find fenced bash/sh blocks
    cmds = []
    for block in re.findall(r"```(?:bash|sh|shell)?\n(.*?)\n```", section, re.DOTALL):
        for line in block.split("\n"):
            line = line.strip()
            if line and not line.startswith("#"):
                cmds.append(line)
    return cmds


def cmd_handoff(args, root: Path) -> int:
    """Generate a session note skeleton."""
    today = dt.date.today().isoformat()
    project = load_yaml(root / ".harness/project-state.yml")
    mission_id = args.mission or get(project, "current", "mission")
    label = mission_id or "no-mission"
    note_path = root / "runs/session-notes" / f"{today}-{label}.md"
    note_path.parent.mkdir(parents=True, exist_ok=True)

    if note_path.exists():
        print(f"error: {note_path} already exists. edit it directly or pass --mission "
              f"to differentiate.", file=sys.stderr)
        return 2

    # Get git info if available
    branch = run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root).strip() or "(none)"
    changed = run_cmd(["git", "diff", "--name-only", "HEAD"], cwd=root).strip()
    if not changed:
        changed = run_cmd(["git", "diff", "--name-only", "--cached"], cwd=root).strip()

    content = f"""# Session Note

Date: {today}
Mission: {mission_id or '(none)'}
Agent: (fill in)
Branch: {branch}

## Summary

- (what you did, 3-5 bullets)

## Files Changed

{format_file_list(changed) if changed else '- (none — read-only session)'}

## Validation

```text
command: (e.g. npm test)
result:  (e.g. 142 passing, 0 failing)
```

## Evidence

Facts:
- (things you directly verified, with file:line if applicable)

Inferences:
- (things you concluded but didn't directly verify, with reasoning)

Assumptions:
- (things you assumed without verification, with what would falsify each)

## Risks

- (what could go wrong from here)

## Follow-Ups

- (work deferred or surfaced)

## Recommended Next Mission

- (what should be picked up next)
"""
    note_path.write_text(content)
    print(colorize(f"{emoji_or_ascii('✓', '[ok]')} session note skeleton written:", "green"))
    print(f"  {note_path.relative_to(root)}")
    print()
    print("fill in the (placeholder) sections before closing.")
    return 0


# ---------- plan (PRD) ----------
#
# A PRD is a reviewed, phased plan produced before missions are written. The
# plan-review pipeline registers it here; the `human_approval_for_plan` gate
# reads `status: approved`. Approval is NOT hand-set — it is projected from the
# approval contract (.harness/approvals/) by `harness plan sync`, so an approved
# plan always has a matching approval-decision behind it.

# Schema versions are DERIVED from the single canonical source —
# packages/contracts/schema-version.json — rather than hand-copied here. The
# contracts package and this CLI both read that sidecar, so the two languages
# cannot silently drift; a cross-language parity test
# (packages/harness/tests/test_contract.py) fails CI on a one-sided change.
#
# Two independent concepts live in the sidecar:
#   - schemaVersion          : the contracts package version as a whole
#   - approvalSchemaVersion  : the per-document version stamped into the
#                              approval-request / approval-decision files this
#                              CLI writes under .harness/approvals/**
#
# Fallback defaults are only used if the sidecar is absent (e.g. a standalone
# harness install detached from the monorepo); they match the committed sidecar
# at the time of writing.
_SCHEMA_VERSION_FALLBACK = 9
_APPROVAL_SCHEMA_VERSION_FALLBACK = 2


def _schema_version_sidecar_path() -> Path:
    # tools/harness -> parents[1] == packages/harness; sibling contracts pkg.
    return _REPO_ROOT.parent / "contracts" / "schema-version.json"


def _resolve_schema_versions() -> dict:
    """Resolve {schemaVersion, approvalSchemaVersion} from the canonical sidecar.

    Reads packages/contracts/schema-version.json (the single source of truth).
    Falls back to the documented defaults only when the sidecar is unreadable,
    so a standalone harness install still works while the monorepo stays
    parity-checked in CI.
    """
    path = _schema_version_sidecar_path()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = {}
    schema_version = data.get("schemaVersion", _SCHEMA_VERSION_FALLBACK)
    approval_version = data.get(
        "approvalSchemaVersion", _APPROVAL_SCHEMA_VERSION_FALLBACK
    )
    return {
        "schemaVersion": schema_version,
        "approvalSchemaVersion": approval_version,
    }


_SCHEMA_VERSIONS = _resolve_schema_versions()
SCHEMA_VERSION = _SCHEMA_VERSIONS["schemaVersion"]
APPROVAL_SCHEMA_VERSION = _SCHEMA_VERSIONS["approvalSchemaVersion"]


def _plan_index_path(root: Path) -> Path:
    return root / ".harness/plan-index.yml"


def _load_plan_index(root: Path) -> dict:
    data = load_yaml(_plan_index_path(root))
    if not isinstance(data.get("plans"), dict):
        data["plans"] = {}
    return data


def _command_hash(plan_id: str, file_rel: str) -> str:
    return hashlib.sha256(f"{plan_id}:{file_rel}".encode()).hexdigest()


def cmd_plan(args, root: Path) -> int:
    action = getattr(args, "plan_action", None) or "list"
    if action == "list":
        return _plan_list(args, root)
    if action == "show":
        return _plan_show(args, root)
    if action == "register":
        return _plan_register(args, root)
    if action == "request":
        return _plan_request(args, root)
    if action == "sync":
        return _plan_sync(args, root)
    print(f"error: unknown plan action: {action}", file=sys.stderr)
    return 2


def _plan_list(args, root: Path) -> int:
    plans = _load_plan_index(root).get("plans") or {}
    if getattr(args, "json", False):
        print(json.dumps(plans, indent=2, default=str))
        return 0
    if not plans:
        print("no PRDs registered. run: harness plan register <id> --file <path>")
        return 0
    print(colorize(f"{emoji_or_ascii('📑', '[plans]')} {len(plans)} PRD(s)", "bold"))
    for pid, data in plans.items():
        if not isinstance(data, dict):
            continue
        status = data.get("status", "unknown")
        color = {"approved": "green", "rejected": "red", "in-review": "yellow"}.get(status, "cyan")
        approver = data.get("approved_by")
        suffix = f"  (approved by {approver})" if approver else ""
        print(f"  {colorize(status, color):20s} {pid}  →  {data.get('file', '?')}{suffix}")
    return 0


def _plan_show(args, root: Path) -> int:
    plans = _load_plan_index(root).get("plans") or {}
    entry = plans.get(args.id)
    if not entry:
        print(f"error: no PRD `{args.id}` in plan-index.yml", file=sys.stderr)
        return 2
    print(json.dumps(entry, indent=2, default=str))
    file_rel = entry.get("file")
    if file_rel and not (root / file_rel).exists():
        print(f"warning: PRD file does not exist: {file_rel}", file=sys.stderr)
    return 0


def _plan_register(args, root: Path) -> int:
    if not args.file:
        print("error: register requires --file <path>", file=sys.stderr)
        return 2
    index = _load_plan_index(root)
    entry = index["plans"].get(args.id) or {}
    entry.setdefault("status", "draft")
    entry.setdefault("approved_by", None)
    entry.setdefault("approved_at", None)
    entry.setdefault("missions", [])
    entry.setdefault("request_id", None)
    entry.setdefault("command_hash", None)
    entry["file"] = args.file
    index["plans"][args.id] = entry
    save_yaml(_plan_index_path(root), index)
    print(colorize(f"{emoji_or_ascii('✓', '[ok]')} registered PRD {args.id} ({entry['status']})", "green"))
    return 0


def _plan_request(args, root: Path) -> int:
    index = _load_plan_index(root)
    entry = index["plans"].get(args.id)
    if not entry:
        print(f"error: no PRD `{args.id}` — register it first", file=sys.stderr)
        return 2
    file_rel = entry.get("file", "")
    req_id = str(uuid.uuid4())
    chash = _command_hash(args.id, file_rel)
    request = {
        "id": req_id,
        "schemaVersion": APPROVAL_SCHEMA_VERSION,
        "projectPath": str(root),
        "tool": "harness-plan",
        "command": f"approve-plan:{args.id}",
        "matchedPattern": "plan-review",
        "riskLevel": "REQUIRES_REVIEW",
        "commandHash": chash,
        "requestedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    pending = root / ".harness/approvals/pending"
    pending.mkdir(parents=True, exist_ok=True)
    (pending / f"{req_id}.json").write_text(json.dumps(request, indent=2) + "\n")

    entry["status"] = "in-review"
    entry["request_id"] = req_id
    entry["command_hash"] = chash
    save_yaml(_plan_index_path(root), index)
    print(colorize(f"{emoji_or_ascii('⏳', '[in-review]')} approval requested for {args.id}", "yellow"))
    print(f"  request: .harness/approvals/pending/{req_id}.json")
    print("  a human decides via the cockpit approval UI, then run: harness plan sync")
    return 0


def _plan_sync(args, root: Path) -> int:
    """Project approval-decision files into plan-index status (allow→approved,
    deny→rejected). Only honors a decision whose commandHash matches the request."""
    index = _load_plan_index(root)
    decided_dir = root / ".harness/approvals/decided"
    changed = 0
    for pid, entry in index["plans"].items():
        if not isinstance(entry, dict) or entry.get("status") != "in-review":
            continue
        req_id = entry.get("request_id")
        if not req_id:
            continue
        decision_path = decided_dir / f"{req_id}.json"
        if not decision_path.exists():
            continue
        try:
            decision = json.loads(decision_path.read_text())
        except (json.JSONDecodeError, OSError) as e:
            print(f"warning: cannot read decision for {pid}: {e}", file=sys.stderr)
            continue
        if decision.get("commandHash") != entry.get("command_hash"):
            print(f"warning: {pid} decision commandHash mismatch — ignoring (stale/replayed)", file=sys.stderr)
            continue
        verdict = decision.get("decision")
        if verdict == "allow":
            entry["status"] = "approved"
            entry["approved_by"] = decision.get("approver")
            entry["approved_at"] = decision.get("decidedAt")
            changed += 1
            print(colorize(f"{emoji_or_ascii('✓', '[ok]')} {pid} approved by {entry['approved_by']}", "green"))
        elif verdict == "deny":
            entry["status"] = "rejected"
            changed += 1
            print(colorize(f"{emoji_or_ascii('✗', '[rejected]')} {pid} rejected", "red"))
    if changed:
        save_yaml(_plan_index_path(root), index)
    else:
        print("no pending decisions to apply")
    return 0


# ---------- mission ----------
#
# The harness owns .harness/mission-index.yml — it is the single writer. The
# cockpit never edits it directly; it shells out to this subcommand. A mission
# graduates draft → ready here once it is well-formed and sequenced, which is
# what `harness next` selects from (it only considers status: ready).

def _mission_index_path(root: Path) -> Path:
    return root / ".harness/mission-index.yml"


def _save_yaml_atomic(path: Path, data: dict) -> None:
    """Write YAML via a temp file + os.replace so a crash mid-write can never
    leave a truncated mission-index.yml. os.replace is atomic on the same
    filesystem, so the temp file is created in the destination directory."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(yaml.safe_dump(data, sort_keys=False, default_flow_style=False))
    os.replace(tmp, path)


# Canonical mission lifecycle states (mirrors the harness-status contract). The
# single writer of mission-index.yml; the cockpit/Fleet shell this rather than
# editing YAML, so outcome write-back stays on one atomic path.
_MISSION_STATES = (
    "draft",
    "ready",
    "in-progress",
    "review",
    "complete",
    "blocked",
    "failed",
)


def cmd_mission(args, root: Path) -> int:
    action = getattr(args, "mission_action", None)
    if action == "ready":
        return _mission_ready(args, root)
    if action == "status":
        return _mission_status(args, root)
    print(f"error: unknown mission action: {action}", file=sys.stderr)
    return 2


def _mission_status(args, root: Path) -> int:
    """Set a mission's status to a canonical lifecycle state (single writer).

    Fleet/loop record a mission outcome (complete/review/failed/blocked/…) via
    this CLI instead of editing mission-index.yml directly, preserving the
    single-writer contract. Errors if the mission is unknown or the target state
    is not canonical. Writes the index back atomically."""
    if args.state not in _MISSION_STATES:
        print(
            f"error: `{args.state}` is not a canonical mission state "
            f"(one of: {', '.join(_MISSION_STATES)})",
            file=sys.stderr,
        )
        return 2
    index = load_yaml(_mission_index_path(root))
    missions = index.get("missions")
    if not isinstance(missions, dict):
        missions = {}
    entry = missions.get(args.id)
    if not isinstance(entry, dict):
        print(f"error: no mission `{args.id}` in mission-index.yml", file=sys.stderr)
        return 2
    entry["status"] = args.state
    missions[args.id] = entry
    index["missions"] = missions
    _save_yaml_atomic(_mission_index_path(root), index)
    print(
        colorize(
            f"{emoji_or_ascii('✓', '[ok]')} mission {args.id} status -> {args.state}",
            "green",
        )
    )
    return 0


def _mission_ready(args, root: Path) -> int:
    """Flip a mission's status from draft → ready in mission-index.yml.

    Errors (non-zero) if the mission is not found or is not currently draft, so
    the caller can surface a precise reason. Writes the index back atomically."""
    index = load_yaml(_mission_index_path(root))
    missions = index.get("missions")
    if not isinstance(missions, dict):
        missions = {}
    entry = missions.get(args.id)
    if not isinstance(entry, dict):
        print(f"error: no mission `{args.id}` in mission-index.yml", file=sys.stderr)
        return 2
    status = entry.get("status")
    if status != "draft":
        print(
            f"error: mission `{args.id}` is `{status}`, not `draft` — "
            f"only draft missions can be marked ready",
            file=sys.stderr,
        )
        return 2
    entry["status"] = "ready"
    missions[args.id] = entry
    index["missions"] = missions
    _save_yaml_atomic(_mission_index_path(root), index)
    print(colorize(f"{emoji_or_ascii('✓', '[ok]')} mission {args.id} marked ready", "green"))
    return 0


# ---------- approve ----------
#
# The harness owns the danger-zone approval contract: a pending request lives at
# .harness/approvals/pending/<requestId>.json and a decision lives at
# .harness/approvals/decided/<requestId>.json (approval-decision schema). The
# harness CLI is the SINGLE WRITER of decided files — the cockpit never writes
# them directly; it shells out to this subcommand. Carrying the pending's
# commandHash onto the decision is the replay-proofing: a decision can only
# unblock the exact command it was minted for.

def _approvals_dir(root: Path, kind: str) -> Path:
    return root / ".harness" / "approvals" / kind


def cmd_approve(args, root: Path) -> int:
    """Decide a pending danger-zone approval (allow|deny).

    Reads .harness/approvals/pending/<requestId>.json, copies its commandHash,
    and writes .harness/approvals/decided/<requestId>.json conforming to the
    approval-decision schema. Errors (non-zero) if the pending file is missing
    or the decision already exists. Writes the decided file atomically."""
    request_id = args.id
    if args.allow == args.deny:
        # Exactly one of --allow / --deny is required (argparse marks them
        # mutually exclusive + required, so this is belt-and-suspenders).
        print("error: exactly one of --allow / --deny is required", file=sys.stderr)
        return 2
    decision = "allow" if args.allow else "deny"

    pending_path = _approvals_dir(root, "pending") / f"{request_id}.json"
    if not pending_path.exists():
        print(
            f"error: no pending approval `{request_id}` "
            f"(.harness/approvals/pending/{request_id}.json not found)",
            file=sys.stderr,
        )
        return 2

    try:
        pending = json.loads(pending_path.read_text())
    except (json.JSONDecodeError, OSError) as e:
        print(f"error: cannot read pending request {request_id}: {e}", file=sys.stderr)
        return 2
    if not isinstance(pending, dict):
        print(f"error: pending request {request_id} is malformed", file=sys.stderr)
        return 2

    command_hash = pending.get("commandHash")
    if not command_hash:
        print(
            f"error: pending request {request_id} has no commandHash — "
            f"cannot mint a replay-proof decision",
            file=sys.stderr,
        )
        return 2

    decided_path = _approvals_dir(root, "decided") / f"{request_id}.json"
    if decided_path.exists():
        print(
            f"error: approval `{request_id}` already decided "
            f"(.harness/approvals/decided/{request_id}.json exists)",
            file=sys.stderr,
        )
        return 2

    decision_doc = {
        "id": request_id,
        "schemaVersion": pending.get("schemaVersion", APPROVAL_SCHEMA_VERSION),
        "decision": decision,
        "approver": args.approver or "cockpit-fleet",
        "commandHash": command_hash,
        "decidedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    }

    decided_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = decided_path.with_name(f".{decided_path.name}.tmp")
    tmp.write_text(json.dumps(decision_doc, indent=2) + "\n")
    os.replace(tmp, decided_path)

    mark = emoji_or_ascii("✓", "[ok]") if decision == "allow" else emoji_or_ascii("✗", "[deny]")
    color = "green" if decision == "allow" else "red"
    print(colorize(f"{mark} approval {request_id} {decision} by {decision_doc['approver']}", color))
    print(f"  decided: .harness/approvals/decided/{request_id}.json")
    return 0


# ---------- utilities ----------

def run_cmd(args_list, cwd):
    try:
        return subprocess.run(args_list, capture_output=True, text=True,
                              cwd=str(cwd), timeout=10).stdout
    except (subprocess.SubprocessError, FileNotFoundError):
        return ""


def find_git_bash_windows() -> Path | None:
    """Return Git Bash on Windows; ignore WSL stub at System32."""
    import shutil

    program_files = os.environ.get("ProgramFiles", r"C:\Program Files")
    program_files_x86 = os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")
    candidates = [
        Path(program_files) / "Git" / "bin" / "bash.exe",
        Path(program_files_x86) / "Git" / "bin" / "bash.exe",
    ]
    which_bash = shutil.which("bash")
    if which_bash:
        p = Path(which_bash)
        if p.exists() and "system32" not in str(p).lower() and "windowsapps" not in str(p).lower():
            candidates.insert(0, p)

    for path in candidates:
        if path.is_file():
            return path
    return None


def resolve_claude_hook_script(cmd: str, root: Path) -> Path:
    """Return the hook .sh path from a Claude settings.json command."""
    expanded = cmd.replace("${CLAUDE_PROJECT_DIR}", str(root))
    quoted_scripts = re.findall(r'"([^"]+\.sh)"', expanded)
    if quoted_scripts:
        return Path(quoted_scripts[-1])
    single_quoted = re.findall(r"'([^']+\.sh)'", expanded)
    if single_quoted:
        return Path(single_quoted[-1])
    return Path(expanded)


def hook_bash_command() -> list[str]:
    """Return argv prefix for running harness hook scripts."""
    if os.name == "nt":
        git_bash = find_git_bash_windows()
        if git_bash is not None:
            return [str(git_bash)]
    return ["bash"]


def run_with_stdin(script_path: Path, stdin_text: str, root: Path, *, cursor: bool = False) -> str:
    env = os.environ.copy()
    env["CLAUDE_PROJECT_DIR"] = str(root)
    env["CURSOR_PROJECT_DIR"] = str(root)
    try:
        result = subprocess.run(
            hook_bash_command() + [str(script_path)],
            input=stdin_text,
            capture_output=True,
            text=True,
            cwd=str(root),
            env=env,
            timeout=10,
        )
        return result.stdout
    except (subprocess.SubprocessError, FileNotFoundError) as e:
        return f"(error: {e})"


def shutil_which(name: str) -> str | None:
    import shutil
    return shutil.which(name)


def format_file_list(files: str) -> str:
    return "\n".join(f"- {f}" for f in files.split("\n") if f)


# ---------- dashboard (v5.1.2) ----------
#
# `harness dashboard` renders runs/dashboard/index.html from the harness state
# files already on disk. It is a read-only renderer: it does not edit, infer,
# or supplement state. Every panel handles missing or empty source files
# gracefully (panel either renders an empty-state hint or hides itself).
#
# Single self-contained HTML file. No external CSS/JS/fonts. No network.
# PyYAML is the only dependency, and tools/harness already requires it.

import html as _html  # noqa: E402  (kept local to dashboard block)


_DASH_DEFAULT_CONFIG = {
    "title": None,           # falls back to f"{project.name} — Harness Dashboard"
    "theme": "dark",         # "dark" or "light"
    "recent_notes": 5,
    "output": "runs/dashboard/index.html",
    "panels": {
        "project": True,
        "current_mission": True,
        "next_action": True,
        "readiness": True,
        "mvp": True,
        "mission_board": True,
        "risks": True,
        "questions": True,
        "session_notes": True,
        "improvements": True,
        "tests": True,
    },
}


def _dash_load_config(root: Path) -> dict:
    """Load dashboard-config.yml if present; merge over defaults."""
    cfg_path = root / ".harness" / "dashboard-config.yml"
    cfg = dict(_DASH_DEFAULT_CONFIG)
    cfg["panels"] = dict(_DASH_DEFAULT_CONFIG["panels"])
    if cfg_path.exists():
        loaded = load_yaml(cfg_path).get("dashboard") or {}
        for k, v in loaded.items():
            if k == "panels" and isinstance(v, dict):
                cfg["panels"].update(v)
            else:
                cfg[k] = v
    return cfg


def _dash_parse_md_section(md_text: str, header: str) -> list[str]:
    """Return non-empty bullet/line entries under a `## <header>` section."""
    items: list[str] = []
    in_sec = False
    target = header.strip().lower()
    for line in md_text.splitlines():
        if line.startswith("##"):
            in_sec = line.lstrip("#").strip().lower() == target
            continue
        if not in_sec:
            continue
        m = re.match(r"^\s*-\s+(.+?)\s*$", line)
        if m:
            entry = m.group(1).strip()
            if entry:
                items.append(entry)
        elif line.strip() and not line.startswith(" "):
            # plain paragraph content (e.g. ## Goal: one-paragraph description)
            items.append(line.strip())
    return items


def _dash_load_data(root: Path) -> dict:
    """Pull everything the dashboard needs into one dict. Missing files = empty."""
    ps    = load_yaml(root / ".harness/project-state.yml")
    mi    = load_yaml(root / ".harness/mission-index.yml")
    mvp   = load_yaml(root / ".harness/mvp-checklist.yml")
    rs    = load_yaml(root / ".harness/readiness-score.yml")
    fl    = load_yaml(root / ".harness/friction-log.yml")
    ib    = load_yaml(root / ".harness/improvement-backlog.yml")

    # Current mission markdown (optional)
    mission_id = get(ps, "current", "mission")
    mission_md = ""
    mission_meta: dict = {}
    if mission_id:
        # Look up file via mission-index, then fall back to a conventional path
        mi_entry = (get(mi, "missions") or {}).get(mission_id) or {}
        rel = mi_entry.get("file") if isinstance(mi_entry, dict) else None
        candidates = []
        if rel:
            candidates.append(root / rel)
        candidates.append(root / "runs/missions" / f"{mission_id}.md")
        for c in candidates:
            if c.exists():
                try:
                    mission_md = c.read_text()
                    mission_meta = {"path": str(c.relative_to(root))}
                except OSError:
                    pass
                break

    # Recent session notes (by mtime)
    notes_dir = root / "runs/session-notes"
    notes: list[dict] = []
    if notes_dir.is_dir():
        for f in sorted(notes_dir.glob("*.md"),
                        key=lambda p: p.stat().st_mtime, reverse=True):
            try:
                first = f.read_text().splitlines()[:8]
            except OSError:
                continue
            title = next((ln.lstrip("# ").strip() for ln in first
                          if ln.startswith("#")), f.stem)
            mission_ref = ""
            for ln in first:
                m = re.match(r"^\s*Mission:\s*(.+?)\s*$", ln)
                if m:
                    mission_ref = m.group(1).strip()
                    break
            notes.append({
                "file": str(f.relative_to(root)),
                "title": title,
                "mission": mission_ref,
                "mtime": dt.datetime.fromtimestamp(f.stat().st_mtime),
            })

    # Test/validation reports (most recent file under runs/test-reports)
    reports_dir = root / "runs/test-reports"
    tests: list[dict] = []
    if reports_dir.is_dir():
        for f in sorted(reports_dir.glob("*"),
                        key=lambda p: p.stat().st_mtime, reverse=True):
            if f.name.startswith(".") or f.is_dir():
                continue
            tests.append({
                "file": str(f.relative_to(root)),
                "mtime": dt.datetime.fromtimestamp(f.stat().st_mtime),
            })

    return {
        "project_state": ps,
        "mission_index": mi,
        "mvp": mvp,
        "readiness": rs,
        "friction": fl,
        "improvements": ib,
        "mission_id": mission_id,
        "mission_md": mission_md,
        "mission_meta": mission_meta,
        "notes": notes,
        "tests": tests,
    }


# ---------- HTML helpers ----------

def _h(s) -> str:
    """HTML-escape a value (None → empty string)."""
    if s is None:
        return ""
    return _html.escape(str(s), quote=True)


def _dash_pill(text: str, kind: str = "neutral") -> str:
    """Render a status pill. kind ∈ ok|warn|fail|info|neutral."""
    return f'<span class="pill pill-{_h(kind)}">{_h(text)}</span>'


def _dash_progress(percent: float, label: str = "") -> str:
    pct = max(0, min(100, int(round(percent))))
    return (
        f'<div class="progress" role="progressbar" aria-valuenow="{pct}" '
        f'aria-valuemin="0" aria-valuemax="100">'
        f'<div class="progress-bar" style="width:{pct}%"></div>'
        f'<div class="progress-label">{_h(label) or f"{pct}%"}</div>'
        f'</div>'
    )


def _dash_empty(message: str) -> str:
    return f'<p class="empty">{_h(message)}</p>'


# ---------- panel renderers ----------
# Each returns (heading, html_body) or None to suppress the panel.

def _panel_current_mission(data: dict):
    mid = data["mission_id"]
    if not mid or mid == "null":
        return ("Current Mission",
                _dash_empty("No mission selected. Run `harness next` to pick one."))
    md = data["mission_md"]
    goal = " ".join(_dash_parse_md_section(md, "Goal")) if md else ""
    acc = _dash_parse_md_section(md, "Acceptance Criteria") if md else []
    done = sum(1 for a in acc if a.lower().startswith("[x]"))
    total = len(acc)
    pct = (done / total * 100) if total else 0
    rows = []
    for a in acc:
        if a.lower().startswith("[x]"):
            rows.append(f'<li class="acc done">{_dash_pill("done", "ok")} '
                        f'{_h(a[3:].strip())}</li>')
        elif a.lower().startswith("[ ]"):
            rows.append(f'<li class="acc open">{_dash_pill("open", "warn")} '
                        f'{_h(a[3:].strip())}</li>')
        else:
            rows.append(f'<li class="acc">{_h(a)}</li>')

    path_link = ""
    if data["mission_meta"].get("path"):
        path_link = (f'<div class="muted small">'
                     f'<code>{_h(data["mission_meta"]["path"])}</code></div>')

    body = [
        f'<div class="mission-id">{_h(mid)}</div>',
        path_link,
    ]
    if goal:
        body.append(f'<p class="goal">{_h(goal)}</p>')
    if total:
        body.append(_dash_progress(pct, f"Acceptance: {done}/{total}"))
        body.append(f'<ul class="acc-list">{"".join(rows)}</ul>')
    else:
        body.append(_dash_empty("No acceptance criteria found in mission."))
    return ("Current Mission", "\n".join(body))


def _panel_project(data: dict):
    ps = data["project_state"]
    rows = [
        ("Mode",  get(ps, "project", "mode") or "unset"),
        ("Stage", get(ps, "project", "stage") or "unset"),
        ("Owner", get(ps, "project", "owner") or "unset"),
        ("Pipeline", get(ps, "current", "pipeline") or "—"),
        ("Branch",   get(ps, "current", "branch") or "—"),
    ]
    body = '<dl class="kv">' + "".join(
        f'<dt>{_h(k)}</dt><dd>{_h(v)}</dd>' for k, v in rows
    ) + '</dl>'
    return ("Project", body)


def _panel_next_action(data: dict):
    nxt = get(data["project_state"], "next") or {}
    action = nxt.get("recommended_action") or "—"
    agent  = nxt.get("recommended_agent")  or "—"
    blocked = bool(nxt.get("blocked"))
    blocker = nxt.get("blocker")
    body = [
        f'<div class="next-action">{_h(action)}</div>',
        f'<div class="muted small">recommended agent: <code>{_h(agent)}</code></div>',
    ]
    if blocked:
        body.append(f'<div class="callout warn">Blocked: {_h(blocker or "see project-state.yml")}</div>')
    return ("Next Recommended Action", "\n".join(body))


def _panel_readiness(data: dict):
    rs = get(data["readiness"], "readiness") or {}
    if not rs:
        return ("Readiness", _dash_empty("No readiness-score.yml data."))
    overall = get(rs, "overall", "score") or 0
    mvp_ready = bool(get(rs, "overall", "mvp_ready"))
    pill = _dash_pill("MVP READY", "ok") if mvp_ready else _dash_pill("not yet", "warn")
    rows = []
    for cat in ("product", "architecture", "engineering", "testing", "security", "release"):
        score = get(rs, cat, "score")
        if score is None:
            continue
        blockers = get(rs, cat, "blockers") or []
        rows.append(
            f'<div class="readiness-row">'
            f'  <div class="readiness-cat">{_h(cat)}</div>'
            f'  <div class="readiness-bar">{_dash_progress(score, f"{score}/100")}</div>'
            f'  <div class="readiness-blockers muted small">'
            f'{_h("; ".join(blockers[:2])) if blockers else ""}</div>'
            f'</div>'
        )
    body = [
        f'<div class="readiness-overall">'
        f'<span class="readiness-score">{_h(overall)}</span>'
        f'<span class="readiness-of">/100</span> {pill}</div>',
        _dash_progress(overall, ""),
        '<div class="readiness-grid">' + "".join(rows) + '</div>',
    ]
    return ("Readiness", "\n".join(body))


def _panel_mvp(data: dict):
    items_by_cat = get(data["mvp"], "items") or {}
    if not items_by_cat:
        return ("MVP Checklist", _dash_empty("No mvp-checklist.yml items."))
    groups_html = []
    total = 0
    done = 0
    for cat, items in items_by_cat.items():
        if not isinstance(items, list):
            continue
        rows = []
        for it in items:
            if not isinstance(it, dict):
                continue
            total += 1
            status = (it.get("status") or "todo").lower()
            kind = {"done": "ok", "in_progress": "info",
                    "blocked": "fail", "todo": "neutral"}.get(status, "neutral")
            if status == "done":
                done += 1
            crit = " (critical)" if it.get("critical") else ""
            rows.append(
                f'<li>{_dash_pill(status, kind)} '
                f'<span class="mvp-id">{_h(it.get("id") or "")}</span> '
                f'{_h(it.get("text") or "")}<span class="muted small">{_h(crit)}</span></li>'
            )
        if rows:
            groups_html.append(
                f'<div class="mvp-group"><h3>{_h(cat)}</h3>'
                f'<ul class="mvp-list">{"".join(rows)}</ul></div>'
            )
    pct = (done / total * 100) if total else 0
    header = _dash_progress(pct, f"{done}/{total} complete")
    return ("MVP Checklist", header + "".join(groups_html))


def _panel_mission_board(data: dict):
    missions = get(data["mission_index"], "missions") or {}
    real = {k: v for k, v in missions.items()
            if isinstance(v, dict) and not k.startswith("_")}
    if not real:
        return ("Mission Board",
                _dash_empty("No missions in mission-index.yml. "
                            "Add entries when ready."))
    rows = []
    for mid, m in real.items():
        status = (m.get("status") or "draft").lower()
        kind = {"complete": "ok", "in-progress": "info",
                "ready": "info", "blocked": "fail",
                "review": "warn", "draft": "neutral"}.get(status, "neutral")
        priority = m.get("priority") or ""
        validation = m.get("validation") or ""
        rows.append(
            f'<tr><td><code>{_h(mid)}</code></td>'
            f'<td>{_dash_pill(status, kind)}</td>'
            f'<td>{_h(priority)}</td>'
            f'<td class="muted small">{_h(validation)}</td></tr>'
        )
    body = (
        '<table class="board"><thead><tr>'
        '<th>Mission</th><th>Status</th><th>Priority</th><th>Validation</th>'
        '</tr></thead><tbody>' + "".join(rows) + '</tbody></table>'
    )
    return ("Mission Board", body)


def _panel_risks(data: dict):
    if data["mission_md"]:
        risks = _dash_parse_md_section(data["mission_md"], "Risks")
        if risks:
            return ("Risks",
                    "<ul class='bullets'>" +
                    "".join(f'<li>{_h(r)}</li>' for r in risks) +
                    "</ul>")
    return ("Risks", _dash_empty("No `## Risks` section in current mission."))


def _panel_questions(data: dict):
    if data["mission_md"]:
        for h in ("Open Questions", "Questions"):
            qs = _dash_parse_md_section(data["mission_md"], h)
            if qs:
                return ("Open Questions",
                        "<ul class='bullets'>" +
                        "".join(f'<li>{_h(q)}</li>' for q in qs) +
                        "</ul>")
    return ("Open Questions",
            _dash_empty("No `## Open Questions` section in current mission."))


def _panel_session_notes(data: dict, limit: int):
    notes = data["notes"][:limit]
    if not notes:
        return ("Recent Session Notes",
                _dash_empty("No session notes yet under runs/session-notes/."))
    rows = []
    for n in notes:
        when = n["mtime"].strftime("%Y-%m-%d %H:%M")
        miss = f' <span class="muted small">· {_h(n["mission"])}</span>' if n["mission"] else ""
        rows.append(
            f'<li><div>{_h(n["title"])}{miss}</div>'
            f'<div class="muted small"><code>{_h(n["file"])}</code> · {_h(when)}</div></li>'
        )
    return ("Recent Session Notes",
            "<ul class='note-list'>" + "".join(rows) + "</ul>")


def _panel_improvements(data: dict):
    friction = get(data["friction"], "friction_events") or []
    improvements = get(data["improvements"], "improvements") or []
    # YAML comment-only files load as [] (or None) so these are robust
    fr_open = [f for f in friction
               if isinstance(f, dict) and (f.get("status") or "open") == "open"]
    imp_open = [i for i in improvements
                if isinstance(i, dict) and (i.get("status") or "proposed")
                in ("proposed", "approved")]
    if not fr_open and not imp_open:
        return ("Friction & Improvements",
                _dash_empty("No open friction events or improvements."))
    blocks = []
    if fr_open:
        rows = "".join(
            f'<li>{_dash_pill(f.get("severity") or "low", "warn")} '
            f'<strong>{_h(f.get("id") or "")}</strong> '
            f'{_h(f.get("description") or f.get("type") or "")}</li>'
            for f in fr_open[:8]
        )
        blocks.append(f'<h3>Friction ({len(fr_open)})</h3>'
                      f'<ul class="bullets">{rows}</ul>')
    if imp_open:
        rows = "".join(
            f'<li>{_dash_pill(i.get("status") or "proposed", "info")} '
            f'<strong>{_h(i.get("id") or "")}</strong> '
            f'{_h(i.get("title") or "")}</li>'
            for i in imp_open[:8]
        )
        blocks.append(f'<h3>Improvements ({len(imp_open)})</h3>'
                      f'<ul class="bullets">{rows}</ul>')
    return ("Friction & Improvements", "".join(blocks))


def _panel_tests(data: dict):
    tests = data["tests"]
    if not tests:
        return ("Validation / Tests",
                _dash_empty("No reports under runs/test-reports/ yet. "
                            "Run `harness validate` to generate one."))
    rows = []
    for t in tests[:5]:
        when = t["mtime"].strftime("%Y-%m-%d %H:%M")
        rows.append(
            f'<li><code>{_h(t["file"])}</code>'
            f'<span class="muted small"> · {_h(when)}</span></li>'
        )
    return ("Validation / Tests",
            "<ul class='bullets'>" + "".join(rows) + "</ul>")


