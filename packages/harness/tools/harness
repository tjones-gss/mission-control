def _write_clean_baselines(target: Path, *, force: bool) -> list:
    """Write clean stateful files for a new project. Returns created relative paths."""
    created = []
    harness_dir = target / ".harness"
    harness_dir.mkdir(parents=True, exist_ok=True)
    baselines = {
        "project-state.yml": _clean_project_state(target.name),
        "pipeline-state.yml": {"pipeline": {"active": "unset", "phase": "unset", "gate": "unset"}},
        "mission-index.yml": {"missions": {}},
    }
    for name, data in baselines.items():
        dst = harness_dir / name
        if dst.exists() and not force:
            continue
        dst.write_text(yaml.safe_dump(data, sort_keys=False))
        created.append(f".harness/{name}")
    return created


def _copy_templates(target: Path, *, force: bool) -> list:
    """Copy reusable config (.harness/*.yml minus stateful), pipelines/, and AGENTS.md
    from the harness package into ``target``. Returns created relative (posix) paths."""
    created = []

    def _rel(p: Path) -> str:
        return str(p.relative_to(target)).replace("\\", "/")

    def _copy_glob(src_dir: Path, dst_dir: Path, *, pattern: str = "*.yml", skip: set = frozenset()):
        if not src_dir.is_dir():
            return
        dst_dir.mkdir(parents=True, exist_ok=True)
        for f in sorted(src_dir.glob(pattern)):
            if f.name in skip:
                continue
            dst = dst_dir / f.name
            if dst.exists() and not force:
                continue
            shutil.copyfile(f, dst)
            created.append(_rel(dst))

    _copy_glob(TEMPLATE_ROOT / ".harness", target / ".harness", skip=_STATEFUL_FILES)
    _copy_glob(TEMPLATE_ROOT / "pipelines", target / "pipelines")
    # Agent role + mission templates the pipelines reference — without these a
    # fresh project reports every pipeline agent as "unresolved" and is DEGRADED.
    _copy_glob(TEMPLATE_ROOT / "agents/roles", target / "agents/roles", pattern="*.md")
    _copy_glob(TEMPLATE_ROOT / "agents/templates", target / "agents/templates", pattern="*.md")

    src_agents = TEMPLATE_ROOT / "AGENTS.md"
    if src_agents.is_file():
        dst = target / "AGENTS.md"
        if not dst.exists() or force:
            shutil.copyfile(src_agents, dst)
            created.append("AGENTS.md")
    return created


def cmd_scaffold(args, target: Path) -> int:
    """Create a brand-new harness project in an (un)initialized directory.

    Unlike ``init`` (which mutates an already-bootstrapped tree), scaffold lays
    down the full template set first, then binds the chosen mode. It writes
    clean baselines for stateful files so a new project never inherits the
    harness package's own live state.
    """
    use_json = getattr(args, "json", False)

    def _emit_err(error: str, message: str, code: int = 2) -> int:
        if use_json:
            print(json.dumps({"ok": False, "error": error, "message": message,
                              "root": str(target)}))
        else:
            print(f"error: {message}", file=sys.stderr)
        return code

    if args.mode not in VALID_MODES:
        return _emit_err("invalid_mode",
                         f"mode must be one of: {', '.join(sorted(VALID_MODES))}")

    target = target.resolve()
    if not target.is_dir():
        return _emit_err("no_target", f"target directory does not exist: {target}")

    force = getattr(args, "force", False)
    if (target / ".harness/project-state.yml").exists() and not force:
        return _emit_err(
            "already_initialized",
            f"already a harness project: {target / '.harness/project-state.yml'} "
            f"exists (use --force to re-scaffold)")

    created = _write_clean_baselines(target, force=force)
    created += _copy_templates(target, force=force)

    try:
        project, pipeline_state, summary = _compute_init_state(target, args.mode)
    except FileNotFoundError as e:
        return _emit_err("pipeline_missing", f"pipeline file missing after scaffold: {e}")
    _write_init_state(target, project, pipeline_state)

    created = sorted(set(created))
    if use_json:
        print(json.dumps({"ok": True, "root": str(target), "mode": summary["mode"],
                          "stage": summary["stage"], "phase": summary["phase"],
                          "created": created}))
    else:
        print(colorize(
            f"{emoji_or_ascii('✓', '[ok]')} scaffolded harness project ({args.mode}) at {target}",
            "green"))
        print(f"  files created: {len(created)}")
        print(f"  phase:         {summary['phase']}")
        print(f"  next agent:    {summary['agent']}")
        print()
        print("run `harness status` to see the full state, or `harness next` to pick a mission.")
    return 0


