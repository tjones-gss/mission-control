def _dash_render_html(data: dict, cfg: dict) -> str:
    """Assemble the full HTML document from panel renderers."""
    ps = data["project_state"]
    project_name = get(ps, "project", "name") or "Project"
    title = cfg.get("title") or f"{project_name} — Harness Dashboard"
    mode = get(ps, "project", "mode") or "unset"
    stage = get(ps, "project", "stage") or "unset"
    generated = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    panel_funcs = [
        ("project",         _panel_project),
        ("current_mission", _panel_current_mission),
        ("next_action",     _panel_next_action),
        ("readiness",       _panel_readiness),
        ("mvp",             _panel_mvp),
        ("mission_board",   _panel_mission_board),
        ("risks",           _panel_risks),
        ("questions",       _panel_questions),
        ("session_notes",   lambda d: _panel_session_notes(d, cfg.get("recent_notes", 5))),
        ("improvements",    _panel_improvements),
        ("tests",           _panel_tests),
    ]
    panels_html = []
    for key, fn in panel_funcs:
        if not cfg["panels"].get(key, True):
            continue
        try:
            result = fn(data)
        except Exception as e:  # never let a single panel kill the page
            result = (key.replace("_", " ").title(),
                      _dash_empty(f"Panel error: {_h(e)}"))
        if result is None:
            continue
        heading, body = result
        extra = " span-2" if key in ("current_mission", "readiness", "mvp") else ""
        panels_html.append(
            f'<section class="panel{extra}">'
            f'<h2>{_h(heading)}</h2>{body}</section>'
        )

    theme_css = _DASH_THEME_LIGHT if cfg.get("theme") == "light" else _DASH_THEME_DARK
    return (
        "<!DOCTYPE html>\n"
        '<html lang="en"><head>'
        '<meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width,initial-scale=1">'
        f'<title>{_h(title)}</title>'
        f'<style>{theme_css}{_DASH_CSS_COMMON}</style>'
        '</head><body>'
        '<header class="top">'
        f'<h1>{_h(title)}</h1>'
        f'<div class="meta">Mode: <code>{_h(mode)}</code> · '
        f'Stage: <code>{_h(stage)}</code> · '
        f'Generated {_h(generated)}</div>'
        '</header>'
        f'<main>{"".join(panels_html)}</main>'
        '<footer class="bottom">'
        'Read-only dashboard rendered from harness state files. '
        'Not a source of truth — edit the underlying YAML / markdown to change anything here.'
        '</footer>'
        '</body></html>\n'
    )


def cmd_dashboard(args, root: Path) -> int:
    """Render runs/dashboard/index.html from harness state files."""
    cfg = _dash_load_config(root)
    output = Path(args.output) if getattr(args, "output", None) else Path(cfg["output"])
    if not output.is_absolute():
        output = root / output

    data = _dash_load_data(root)
    html_doc = _dash_render_html(data, cfg)

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(html_doc, encoding="utf-8")
    rel = output.relative_to(root) if output.is_relative_to(root) else output

    panels_on = sum(1 for v in cfg["panels"].values() if v)
    print(f"wrote {rel}  ({panels_on} panel(s), theme={cfg.get('theme')})")

    if getattr(args, "open", False):
        import webbrowser
        webbrowser.open(output.as_uri())

    return 0


# ---------- main ----------

def main():
    parser = argparse.ArgumentParser(
        prog="harness",
        description="Control plane CLI for the Adaptive Agentic Engineering Harness.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-C", "--cwd", help="Run as if in this path", default=None)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_status = sub.add_parser("status", help="Show project state, pipeline, missions, blockers")
    p_status.add_argument("--json", action="store_true", help="Machine-readable JSON output")

    p_check = sub.add_parser("check", help="Verify harness is installed and wired correctly")
    p_check.add_argument("--strict", action="store_true", help="Exit non-zero on warnings")

    p_next = sub.add_parser("next", help="Apply mission selection policy")
    p_next.add_argument("--json", action="store_true", help="Machine-readable JSON output")

    p_init = sub.add_parser("init", help="Bootstrap project-state for a mode")
    p_init.add_argument("mode", help="One of: idea-to-mvp, mvp-sketch, existing-repo-retrofit, "
                                     "feature-development, bugfix, refactor, release-readiness")
    p_init.add_argument("--dry-run", action="store_true", help="Show what would change, do not write")
    p_init.add_argument(
        "--skip-cursor",
        action="store_true",
        help="Do not install Cursor adapter hooks after writing state",
    )

    p_install = sub.add_parser("install", help="Install harness adapters or extras")
    p_install_sub = p_install.add_subparsers(dest="install_target", required=True)
    p_install_sub.add_parser("cursor", help="Install Cursor hooks + SDK pip packages")
    p_install_sub.add_parser("claude", help="Install Claude Code adapter (.claude/ + CLAUDE.md)")

    p_setup = sub.add_parser(
        "setup",
        help="Wire core harness on this machine (Cursor hooks + Claude adapter + check)",
    )
    p_setup.add_argument(
        "--skip-cursor",
        action="store_true",
        help="Do not install Cursor adapter hooks",
    )
    p_setup.add_argument(
        "--skip-claude",
        action="store_true",
        help="Do not install Claude Code adapter",
    )

    sub.add_parser("validate", help="Run validation commands from active mission, write report")

    p_handoff = sub.add_parser("handoff", help="Generate a session note skeleton")
    p_handoff.add_argument("--mission", help="Mission ID (defaults to project.current.mission)")

    p_dashboard = sub.add_parser(
        "dashboard",
        help="Generate a local HTML dashboard at runs/dashboard/index.html",
    )
    p_dashboard.add_argument(
        "--output",
        help="Override output path (default: runs/dashboard/index.html or "
             ".harness/dashboard-config.yml `output:`)",
    )
    p_dashboard.add_argument(
        "--open", action="store_true",
        help="Open the generated dashboard in the default browser",
    )

    args = parser.parse_args()

    start = Path(args.cwd) if args.cwd else Path.cwd()
    root = find_harness_root(start)
    if not root:
        print(f"error: not in a harness project (no .harness/ directory found from {start})",
              file=sys.stderr)
        return 2

    handlers = {
        "status": cmd_status,
        "check": cmd_check,
        "next": cmd_next,
        "init": cmd_init,
        "setup": cmd_setup,
        "validate": cmd_validate,
        "handoff": cmd_handoff,
        "dashboard": cmd_dashboard,
    }
    if args.cmd == "install":
        if args.install_target == "cursor":
            return cmd_install_cursor(args, root)
        if args.install_target == "claude":
            return cmd_install_claude(args, root)
        print(f"error: unknown install target: {args.install_target}", file=sys.stderr)
        return 2
    return handlers[args.cmd](args, root)


if __name__ == "__main__":
    sys.exit(main())
