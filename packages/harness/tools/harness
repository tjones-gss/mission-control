def load_yaml(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        data = yaml.safe_load(path.read_text()) or {}
        return data if isinstance(data, dict) else {}
    except yaml.YAMLError as e:
        raise SystemExit(f"error: failed to parse {path}: {e}") from e


