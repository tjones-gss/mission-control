{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .cursor/hooks/session-start-load-state.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .cursor/hooks/block-danger.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .cursor/hooks/require-mission.sh",
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "\"C:\\Program Files\\Git\\bin\\bash.exe\" .cursor/hooks/stop-session-note-reminder.sh"
      }
    ]
  }
}
