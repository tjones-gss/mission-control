{
  "name": "oversight-server",
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch-path=./index.js --watch-path=./routes --watch-path=./middleware --watch-path=./lib --watch-path=./parsers --watch-path=./intelligence --watch-path=./watcher.js --watch-path=./sse.js --watch-path=./pty-session.js --watch-path=./claude-cli.js --watch index.js",
    "start": "node index.js",
    "openapi:export": "node scripts/export-openapi.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "chokidar": "^3.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "mission-control": "file:../../..",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  }
}
