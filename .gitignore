# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/

# Logs
*.log

# Temp
tmp/
**/tmp/

# Coverage / test artifacts
coverage/
playwright-report/
test-results/

# Environment
.env
.env.local

# Python
**/__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Cockpit Fleet runtime state — per-run JSONs + saved templates (localhost runtime
# data, not source). e2e and live runs write here; keep it out of the repo so a
# late async write can't trip prettier --check. (data/session-names.json stays tracked.)
apps/cockpit/server/data/fleet/
apps/cockpit/server/data/fleet-templates/
apps/cockpit/server/data/audit/

# Council / premortem analysis artifacts — local, revisitable reports (not source).
# The brace form council-*.{md,html,json} does NOT work in .gitignore (no brace
# expansion), so enumerate the extensions explicitly.
council-*.md
council-*.html
council-*.json
premortem-*.md
premortem-*.html
premortem-*.json

# UI/UX redesign session artifacts — local, not source.
# Claude Design handoff bundle, Playwright MCP output, and ad-hoc UI screenshots.
.design-handoff/
.playwright-mcp/
mc-*.png

# Local tool state — codegraph index DB + Claude Code session locks, not source.
.codegraph/
.claude/scheduled_tasks.lock
