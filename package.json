{
  "name": "@mission-control/app",
  "version": "0.5.0",
  "description": "Mission Control — a live cockpit for Claude Code agents. Run `npx @mission-control/app` to go from zero to a running cockpit.",
  "bin": "bin/start.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin/",
    "scripts/",
    "installers/",
    "packages/contracts/",
    "apps/cockpit/package.json",
    "apps/cockpit/server/",
    "apps/cockpit/client/",
    "README.md",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/test/**",
    "!**/*.test.*",
    "!**/vitest*.config.*",
    "!**/e2e/**",
    "!**/e2e-server/**",
    "!**/fixtures/**",
    "!**/__fixtures__/**",
    "!**/test-results/**",
    "!**/playwright-report/**",
    "!**/coverage/**",
    "!apps/cockpit/client/dist/**",
    "!apps/cockpit/server/data/**",
    "!scripts/release/**"
  ],
  "workspaces": [
    "apps/cockpit",
    "packages/contracts"
  ],
  "scripts": {
    "setup": "node installers/setup.mjs",
    "setup:check": "node installers/setup.mjs --check",
    "up": "node scripts/wait-ready.js",
    "up:docker": "docker compose -f docker/docker-compose.yml up --build",
    "down:docker": "docker compose -f docker/docker-compose.yml down",
    "dev": "npm run up",
    "test:cockpit": "npm --prefix apps/cockpit test",
    "lint": "npm --prefix apps/cockpit run lint"
  }
}
